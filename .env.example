# Environment template for FloBama OS
# Copy to .env.local for Next.js. Never commit real credentials.

# Supabase project URL from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) key. Safe for the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin used in password-reset email redirects.
# Local default: http://localhost:43123
# Production: https://your-deployment.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:43123

# Optional: set to 1 only in a disposable/local Supabase project when running
# tests/rls.test.ts. Do not point this at production.
# RLS_TEST_ENABLED=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
