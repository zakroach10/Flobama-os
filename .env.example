# Environment template for FloBama OS
# Copy to .env.local for Next.js. Never commit real credentials.

# Supabase project URL from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) key. Safe for the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin for embeds, API snippets, overlay URLs, and auth redirects.
# Local: http://localhost:43123
# Production: https://flobama-os.vercel.app
NEXT_PUBLIC_SITE_URL=https://flobama-os.vercel.app

# Server-only. Required to create staff logins from Settings.
# Project Settings → API → service_role. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to 1 only in a disposable/local Supabase project when running
# tests/rls.test.ts. Do not point this at production.
# RLS_TEST_ENABLED=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# GoHighLevel Private Integration (server-only). Never prefix with NEXT_PUBLIC_.
# Booking inbox is off until both token and location id are set.
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=
# GHL_API_VERSION=2021-07-28
# Optional schema-key overrides if object labels do not match exactly.
# Band submissions default to custom_objects.band_inquiries when unset.
# GHL_OBJECT_BAND_SUBMISSION=custom_objects.band_inquiries
# GHL_OBJECT_PRIVATE_EVENTS=
