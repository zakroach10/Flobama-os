{
  "name": "flobama-guest",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:unit": "npx --yes tsx src/lib/tickets.test.ts && npx --yes tsx src/lib/event-status.test.ts",
    "doctor": "npx expo-doctor",
    "config:check": "npx expo config --type public",
    "eas:build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "eas:submit:preview": "npx eas-cli@latest submit --platform ios --profile preview --latest"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/source-sans-3": "^0.4.2",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "luxon": "^3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
