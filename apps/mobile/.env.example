# FloBama guest mobile — public env only.
# Copy to .env.local for local/cloud agent runs. Never commit real secrets.
# Never put SUPABASE_SERVICE_ROLE_KEY, GHL tokens, CRON secrets, or Stripe keys here.

# Public FloBama OS origin (no trailing slash). Used for /api/public/v1/* only.
EXPO_PUBLIC_API_BASE_URL=https://flobama-os.vercel.app

# Optional overrides when you own these identifiers (do not invent):
# IOS_BUNDLE_IDENTIFIER=com.yourcompany.flobama
# ANDROID_PACKAGE=com.yourcompany.flobama
# EAS_PROJECT_ID=
# EXPO_OWNER=

# EAS Submit (set in Expo dashboard secrets or your shell — not in git):
# ASC_APP_ID=
# APPLE_TEAM_ID=
# EXPO_APPLE_ID=
# ASC_API_KEY_PATH=
# ASC_API_KEY_ID=
# ASC_API_KEY_ISSUER_ID=
