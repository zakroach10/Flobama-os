{
  "expo": {
    "name": "FloBama",
    "slug": "flobama",
    "scheme": "flobama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/flobama-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/flobama-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0c0c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flobamadowntown.app"
    },
    "android": {
      "package": "com.flobamadowntown.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/flobama-logo.png",
        "backgroundColor": "#0c0c0c"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-video"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
